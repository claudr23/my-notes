views:
  - type: table
    name: Table
    filters:
      and:
        - file.name.contains("session")
        - file.folder == "content/Session Notes"
    order:
      - file.name
      - date
      - summary
    sort:
      - property: file.mtime
        direction: ASC
    columnSize:
      file.name: 145
      note.date: 130
